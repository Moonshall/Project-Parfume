---
import '../styles/global.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f4ed" />
    <title>Masuk | FAMELLO STUDIO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="login-page">
    <img class="login-decoration login-decoration-left" src="https://i.imgur.com/zPAX2sr.png" alt="" aria-hidden="true" />
    <img class="login-decoration login-decoration-right" src="https://i.imgur.com/KDAWDZE.png" alt="" aria-hidden="true" />
    <main class="login-main">
      <section class="login-panel" aria-labelledby="login-title">
        <a class="login-brand" href="/" aria-label="FAMELLO STUDIO">
          <span class="login-brand-mark" aria-hidden="true">F</span>
          <span><strong>FAMELLO</strong><small>Parfum Studio</small></span>
        </a>

        <div class="login-heading">
          <span class="eyebrow">KASIR TOKO</span>
          <h1 id="login-title">Masuk ke kasir.</h1>
          <p>Masukkan nama pengguna dan kata sandi.</p>
        </div>

        <form class="login-form" id="login-form">
          <div class="form-group">
            <label for="username">Nama pengguna</label>
            <input class="form-control" id="username" name="username" type="text" autocomplete="username" required />
          </div>
          <div class="form-group">
            <label for="password">Kata sandi</label>
            <div class="password-control">
              <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required />
              <button class="password-toggle" id="password-toggle" type="button" aria-controls="password" aria-label="Tampilkan kata sandi" aria-pressed="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z" />
                  <circle cx="12" cy="12" r="2.5" />
                </svg>
              </button>
            </div>
          </div>
          <p class="login-error" id="login-error" role="alert" hidden></p>
          <button class="btn btn-primary btn-wide login-submit" id="login-submit" type="submit">Masuk ke FAMELLO</button>
        </form>

        
      </section>

      <aside class="login-showcase" aria-label="Sistem kasir FAMELLO">
        <div class="showcase-badge"><span aria-hidden="true">✦</span> FAMELLO STUDIO</div>
        <div class="showcase-copy">
          <span class="eyebrow">PENJUALAN</span>
          <h2>Kasir FAMELLO</h2>
        </div>
        <div class="showcase-vial" aria-hidden="true">
          <div class="showcase-vial-cap"></div>
          <div class="showcase-vial-neck"></div>
          <div class="showcase-vial-body"><span>FAMELLO</span><small>EAU DE PARFUM</small><i></i></div>
          <div class="showcase-vial-shadow"></div>
        </div>
        <span class="showcase-caption">PRODUK · MEMBER · TRANSAKSI</span>
      </aside>
      <footer class="login-footer"><span>FAMELLO STUDIO</span><span>Sistem kasir toko</span></footer>
    </main>

    <script>
      import { getHomeForRole, getSession, signIn } from '../lib/auth.js';

      const currentSession = getSession();
      if (currentSession) window.location.replace(getHomeForRole(currentSession.role));

      const form = document.getElementById('login-form') as HTMLFormElement;
      const error = document.getElementById('login-error') as HTMLElement;
      const password = document.getElementById('password') as HTMLInputElement;
      const passwordToggle = document.getElementById('password-toggle') as HTMLButtonElement;
      const submitButton = document.getElementById('login-submit') as HTMLButtonElement;
      const defaultSubmitLabel = submitButton.textContent ?? 'Masuk ke FAMELLO';

      passwordToggle.addEventListener('click', () => {
        const reveal = password.type === 'password';
        password.type = reveal ? 'text' : 'password';
        passwordToggle.setAttribute('aria-pressed', String(reveal));
        passwordToggle.setAttribute('aria-label', reveal ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi');
        passwordToggle.classList.toggle('revealed', reveal);
      });

      function resetSubmitState() {
        submitButton.disabled = false;
        submitButton.removeAttribute('aria-busy');
        submitButton.textContent = defaultSubmitLabel;
      }

      form.addEventListener('submit', event => {
        event.preventDefault();
        const formData = new FormData(form);
        const username = String(formData.get('username') || '');
        const enteredPassword = String(formData.get('password') || '');

        submitButton.disabled = true;
        submitButton.setAttribute('aria-busy', 'true');
        submitButton.textContent = 'Memeriksa...';
        window.requestAnimationFrame(() => {
          try {
            const role = signIn(username, enteredPassword);
            if (!role) {
              error.textContent = 'Nama pengguna atau kata sandi tidak sesuai.';
              error.hidden = false;
              password.focus();
              resetSubmitState();
              return;
            }
            window.location.assign(getHomeForRole(role));
          } catch (loginError) {
            error.textContent = loginError instanceof Error
              ? `Login gagal: ${loginError.message}`
              : 'Login gagal. Periksa pengaturan penyimpanan browser.';
            error.hidden = false;
            resetSubmitState();
          }
        });
      });

      form.addEventListener('input', () => {
        error.hidden = true;
      });
    </script>
  </body>
</html>
